# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public origin for canonical URLs, sitemap.xml, and social preview links.
# Set this in the production environment before a public launch. Do not use localhost.
NEXT_PUBLIC_SITE_URL=https://businesstechguelph.ca

# Search indexing stays off for local development and for Vercel preview
# deployments (VERCEL_ENV=preview), even if NEXT_PUBLIC_SITE_URL is set.
# Vercel production (VERCEL_ENV=production) is indexed once the site URL is set.
# For a non-Vercel production host, set BTG_INDEXING=production on that host only.
# BTG_INDEXING=

# Server-only. Do not prefix these with NEXT_PUBLIC_.
# Leave them empty until BTG approves a destination inbox. The contact form
# does not send while contactSubmissionEnabled is false in lib/contact-fields.ts.

# API key from https://resend.com
RESEND_API_KEY=

# Inbox that should receive contact form messages. Not yet confirmed.
# Do not use a personal or corporate address until BTG approves it.
BTG_CONTACT_TO_EMAIL=

# Sender authorized in Resend, for example: Business Technologies Guelph <hello@your-domain>
BTG_CONTACT_FROM_EMAIL=

# Rate limiting for Vercel. Create a Redis database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
